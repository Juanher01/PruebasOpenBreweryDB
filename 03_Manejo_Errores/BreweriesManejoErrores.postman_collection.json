    {
      "name": "TC-ERR-001: Recurso inexistente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"El código HTTP es 404 Not Found\", function () {\r",
              "    pm.response.to.have.status(404);\r",
              "});\r",
              "\r",
              "pm.test(\"La respuesta indica que no fue encontrado\", function () {\r",
              "    try {\r",
              "        // Intentamos ver si la API devolvió un JSON con un mensaje de error\r",
              "        var jsonData = pm.response.json();\r",
              "        pm.expect(jsonData).to.be.an('object');\r",
              "    } catch (e) {\r",
              "        // Si no devuelve JSON y lanza error al parsear, validamos que el cuerpo esté vacío\r",
              "        pm.expect(pm.response.text()).to.be.empty;\r",
              "    }\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
