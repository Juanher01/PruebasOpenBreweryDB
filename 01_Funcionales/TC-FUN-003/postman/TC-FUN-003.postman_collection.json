{
  "info": {
    "_postman_id": "8e2f6a1c-9b4d-4d7e-b3a1-tcfun003col",
    "name": "Open BreweryDB - Pruebas Funcionales",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC-FUN-003",
      "item": [
        {
          "name": "TC-FUN-003 - Búsqueda por nombre",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC-FUN-003 - Búsqueda por nombre (query=san)",
                  "pm.test(\"TC-FUN-003 | HTTP 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-003 | La respuesta es JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\"))",
                  "        .to.include(\"application/json\");",
                  "});",
                  "",
                  "let searchResponse;",
                  "",
                  "pm.test(\"TC-FUN-003 | El cuerpo contiene JSON válido\", function () {",
                  "    pm.expect(function () {",
                  "        searchResponse = pm.response.json();",
                  "    }).to.not.throw();",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-003 | La respuesta es un arreglo\", function () {",
                  "    pm.expect(searchResponse).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-003 | La búsqueda retorna al menos un resultado\", function () {",
                  "    pm.expect(searchResponse.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-003 | Todos los resultados son objetos\", function () {",
                  "    searchResponse.forEach(function (brewery) {",
                  "        pm.expect(brewery).to.be.an(\"object\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-003 | Todos los resultados contienen name\", function () {",
                  "    searchResponse.forEach(function (brewery) {",
                  "        pm.expect(brewery).to.have.property(\"name\");",
                  "        pm.expect(brewery.name).to.be.a(\"string\");",
                  "    });",
                  "});",
                  "",
                  "pm.test('TC-FUN-003 | Todos los nombres contienen \"san\"', function () {",
                  "    searchResponse.forEach(function (brewery) {",
                  "        pm.expect(brewery.name.toLowerCase()).to.include(\"san\");",
                  "    });",
                  "});",
                  "",
                  "// Datos de diagnóstico",
                  "console.log(\"TC-FUN-003 | Fecha/hora:\", new Date().toISOString());",
                  "console.log(\"TC-FUN-003 | URL:\", pm.request.url.toString());",
                  "console.log(\"TC-FUN-003 | HTTP:\", pm.response.code, pm.response.status);",
                  "console.log(\"TC-FUN-003 | Content-Type:\", pm.response.headers.get(\"Content-Type\"));",
                  "if (Array.isArray(searchResponse)) {",
                  "    console.log(\"TC-FUN-003 | Cantidad de resultados:\", searchResponse.length);",
                  "    console.log(",
                  "        \"TC-FUN-003 | Nombres:\",",
                  "        searchResponse.map(function (brewery) {",
                  "            return brewery.name;",
                  "        })",
                  "    );",
                  "}",
                  "console.log(",
                  "    \"TC-FUN-003 | Response Time:\",",
                  "    pm.response.responseTime,",
                  "    \"ms\"",
                  ");"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/breweries/search?query=san",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "breweries",
                "search"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "san"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
