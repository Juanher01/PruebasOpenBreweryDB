{
  "info": {
    "_postman_id": "b5e9f3a7-6c0d-4b2f-9d4e-tcfun007col",
    "name": "Open BreweryDB - Pruebas Funcionales",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC-FUN-007",
      "item": [
        {
          "name": "TC-FUN-007 - Filtrado por Tipo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC-FUN-007 - Filtrado por Tipo (by_type=micro)",
                  "pm.test(\"TC-FUN-007 | HTTP 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-007 | La respuesta es JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\"))",
                  "        .to.include(\"application/json\");",
                  "});",
                  "",
                  "let typeResponse;",
                  "",
                  "pm.test(\"TC-FUN-007 | El cuerpo contiene JSON válido\", function () {",
                  "    pm.expect(function () {",
                  "        typeResponse = pm.response.json();",
                  "    }).to.not.throw();",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-007 | La respuesta es un arreglo\", function () {",
                  "    pm.expect(typeResponse).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-007 | El filtro retorna al menos un resultado\", function () {",
                  "    pm.expect(typeResponse.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-007 | Todos los resultados son objetos\", function () {",
                  "    typeResponse.forEach(function (brewery) {",
                  "        pm.expect(brewery).to.be.an(\"object\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-007 | Todos los resultados contienen brewery_type\", function () {",
                  "    typeResponse.forEach(function (brewery) {",
                  "        pm.expect(brewery).to.have.property(\"brewery_type\");",
                  "        pm.expect(brewery.brewery_type).to.be.a(\"string\");",
                  "    });",
                  "});",
                  "",
                  "pm.test('TC-FUN-007 | Todos los registros tienen brewery_type \"micro\"', function () {",
                  "    typeResponse.forEach(function (brewery) {",
                  "        pm.expect(brewery.brewery_type.toLowerCase()).to.eql(\"micro\");",
                  "    });",
                  "});",
                  "",
                  "// Diagnóstico adicional (no sustituye ni altera las assertions)",
                  "console.log(\"TC-FUN-007 | Fecha/hora:\", new Date().toISOString());",
                  "console.log(\"TC-FUN-007 | URL:\", pm.request.url.toString());",
                  "console.log(\"TC-FUN-007 | HTTP:\", pm.response.code, pm.response.status);",
                  "console.log(\"TC-FUN-007 | Content-Type:\", pm.response.headers.get(\"Content-Type\"));",
                  "if (Array.isArray(typeResponse)) {",
                  "    console.log(\"TC-FUN-007 | Cantidad de resultados:\", typeResponse.length);",
                  "",
                  "    console.log(",
                  "        \"TC-FUN-007 | Tipos retornados:\",",
                  "        typeResponse.map(function (brewery) {",
                  "            return brewery.brewery_type;",
                  "        })",
                  "    );",
                  "",
                  "    const nonMicro = typeResponse.filter(function (brewery) {",
                  "        return typeof brewery.brewery_type !== \"string\" ||",
                  "               brewery.brewery_type.toLowerCase() !== \"micro\";",
                  "    });",
                  "",
                  "    console.log(",
                  "        \"TC-FUN-007 | Registros no conformes:\",",
                  "        nonMicro.length",
                  "    );",
                  "}",
                  "console.log(",
                  "    \"TC-FUN-007 | Response Time:\",",
                  "    pm.response.responseTime,",
                  "    \"ms\"",
                  ");"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/breweries?by_type=micro",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "breweries"
              ],
              "query": [
                {
                  "key": "by_type",
                  "value": "micro"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
