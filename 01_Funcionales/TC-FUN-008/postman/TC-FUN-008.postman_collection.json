{
  "info": {
    "_postman_id": "c6f0a4b8-7d1e-4c3a-a5f7-tcfun008col",
    "name": "Open BreweryDB - Pruebas Funcionales",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC-FUN-008",
      "item": [
        {
          "name": "TC-FUN-008 - Paso 1 - Página 1 de referencia",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Se limpian valores previos: los IDs de página 1 deben obtenerse en esta ejecución",
                  "pm.environment.set(\"page1_ids\", \"\");",
                  "pm.environment.set(\"page1_count\", \"\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC-FUN-008 - Paso 1: página 1 de referencia (page=1&per_page=5)",
                  "pm.test(\"TC-FUN-008 PRE | Página 1 responde HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "let page1Response;",
                  "",
                  "pm.test(\"TC-FUN-008 PRE | Página 1 contiene JSON válido\", function () {",
                  "    pm.expect(function () {",
                  "        page1Response = pm.response.json();",
                  "    }).to.not.throw();",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-008 PRE | Página 1 es un arreglo\", function () {",
                  "    pm.expect(page1Response).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-008 PRE | Página 1 contiene máximo 5 registros\", function () {",
                  "    pm.expect(page1Response.length).to.be.at.most(5);",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-008 PRE | Página 1 contiene registros\", function () {",
                  "    pm.expect(page1Response.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-008 PRE | Registros de página 1 contienen id\", function () {",
                  "    page1Response.forEach(function (brewery) {",
                  "        pm.expect(brewery).to.have.property(\"id\");",
                  "        pm.expect(brewery.id).to.be.a(\"string\");",
                  "    });",
                  "});",
                  "",
                  "// Guardar dinámicamente los IDs de página 1",
                  "if (Array.isArray(page1Response)) {",
                  "    const page1Ids = page1Response.map(function (brewery) {",
                  "        return brewery.id;",
                  "    });",
                  "",
                  "    pm.environment.set(\"page1_ids\", JSON.stringify(page1Ids));",
                  "    pm.environment.set(\"page1_count\", String(page1Response.length));",
                  "",
                  "    console.log(\"TC-FUN-008 | Página 1 IDs:\", page1Ids);",
                  "    console.log(\"TC-FUN-008 | Página 1 cantidad:\", page1Response.length);",
                  "}",
                  "console.log(\"TC-FUN-008 | Página 1 URL:\", pm.request.url.toString());",
                  "console.log(\"TC-FUN-008 | Página 1 HTTP:\", pm.response.code, pm.response.status);",
                  "console.log(\"TC-FUN-008 | Response Time página 1:\", pm.response.responseTime, \"ms\");"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/breweries?page=1&per_page=5",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "breweries"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "5"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC-FUN-008 - Paso 2 - Página 2 personalizada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC-FUN-008 - Paso 2: página 2 personalizada (page=2&per_page=5)",
                  "pm.test(\"TC-FUN-008 | HTTP 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-008 | La respuesta es JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\"))",
                  "        .to.include(\"application/json\");",
                  "});",
                  "",
                  "let page2Response;",
                  "",
                  "pm.test(\"TC-FUN-008 | El cuerpo contiene JSON válido\", function () {",
                  "    pm.expect(function () {",
                  "        page2Response = pm.response.json();",
                  "    }).to.not.throw();",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-008 | La respuesta es un arreglo\", function () {",
                  "    pm.expect(page2Response).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-008 | per_page=5 es respetado\", function () {",
                  "    pm.expect(page2Response.length).to.be.at.most(5);",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-008 | Página 2 contiene registros\", function () {",
                  "    pm.expect(page2Response.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"TC-FUN-008 | Registros de página 2 contienen id\", function () {",
                  "    page2Response.forEach(function (brewery) {",
                  "        pm.expect(brewery).to.have.property(\"id\");",
                  "        pm.expect(brewery.id).to.be.a(\"string\");",
                  "    });",
                  "});",
                  "",
                  "const page1IdsStored = JSON.parse(",
                  "    pm.environment.get(\"page1_ids\") || \"[]\"",
                  ");",
                  "",
                  "let page2Ids;",
                  "",
                  "pm.test(\"TC-FUN-008 | Los registros de página 2 difieren de página 1\", function () {",
                  "    // Se calcula dentro del test: si page2Response no es un arreglo, la assertion falla",
                  "    page2Ids = page2Response.map(function (brewery) {",
                  "        return brewery.id;",
                  "    });",
                  "",
                  "    pm.expect(page2Ids).to.not.deep.equal(page1IdsStored);",
                  "});",
                  "",
                  "// Diagnóstico de solapamiento (no produce FAIL por sí mismo)",
                  "if (Array.isArray(page2Ids)) {",
                  "    const overlappingIds = page2Ids.filter(function (id) {",
                  "        return page1IdsStored.includes(id);",
                  "    });",
                  "",
                  "    console.log(\"TC-FUN-008 | Página 1 IDs:\", page1IdsStored);",
                  "    console.log(\"TC-FUN-008 | Página 2 IDs:\", page2Ids);",
                  "    console.log(\"TC-FUN-008 | IDs solapados:\", overlappingIds);",
                  "    console.log(\"TC-FUN-008 | Página 2 cantidad:\", page2Response.length);",
                  "}",
                  "console.log(\"TC-FUN-008 | Página 2 URL:\", pm.request.url.toString());",
                  "console.log(\"TC-FUN-008 | Página 2 HTTP:\", pm.response.code, pm.response.status);",
                  "console.log(",
                  "    \"TC-FUN-008 | Response Time página 2:\",",
                  "    pm.response.responseTime,",
                  "    \"ms\"",
                  ");"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/breweries?page=2&per_page=5",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "breweries"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "2"
                },
                {
                  "key": "per_page",
                  "value": "5"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
