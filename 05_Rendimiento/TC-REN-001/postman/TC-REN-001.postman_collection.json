  "item": [
    {
      "name": "TC-REN-001",
      "item": [
        {
          "name": "TC-REN-001 - Latencia de listado simple",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC-REN-001 - Latencia de listado simple (una sola request, sin concurrencia)",
                  "pm.test(\"TC-REN-001 | HTTP 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Umbral estricto: < 2000 ms (2000 ms es FAIL)",
                  "pm.test(\"TC-REN-001 | Response Time menor a 2000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"TC-REN-001 | Response Time válido\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.a(\"number\");",
                  "    pm.expect(pm.response.responseTime).to.be.at.least(0);",
                  "});",
                  "",
                  "// Validaciones auxiliares (no sustituyen la métrica de rendimiento)",
                  "pm.test(\"TC-REN-001 | Content-Type JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\"))",
                  "        .to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"TC-REN-001 | La respuesta contiene JSON válido\", function () {",
                  "    pm.expect(function () {",
                  "        pm.response.json();",
                  "    }).to.not.throw();",
                  "});",
                  "",
                  "// Diagnóstico",
                  "console.log(",
                  "    \"TC-REN-001 | Response Time:\",",
                  "    pm.response.responseTime,",
                  "    \"ms\"",
                  ");",
                  "",
                  "console.log(",
                  "    \"TC-REN-001 | Umbral:\",",
                  "    \"< 2000 ms\"",
                  ");",
                  "",
                  "console.log(",
                  "    \"TC-REN-001 | Cumple:\",",
                  "    pm.response.responseTime < 2000",
                  ");",
                  "",
                  "console.log(",
                  "    \"TC-REN-001 | HTTP:\",",
                  "    pm.response.code",
                  ");",
                  "",
                  "console.log(",
                  "    \"TC-REN-001 | Response Size:\",",
                  "    pm.response.responseSize,",
                  "    \"bytes\"",
                  ");",
                  "console.log(\"TC-REN-001 | URL:\", pm.request.url.toString());",
                  "console.log(\"TC-REN-001 | Fecha/hora:\", new Date().toISOString());"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/breweries",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "breweries"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
