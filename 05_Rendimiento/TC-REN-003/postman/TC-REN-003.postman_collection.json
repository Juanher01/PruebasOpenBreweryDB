  "item": [
    {
      "name": "TC-REN-003",
      "item": [
        {
          "name": "TC-REN-003 - Estabilidad bajo repetición",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC-REN-003 - Estabilidad bajo repetición (misma request en cada iteración, secuencial)",
                  "pm.test(\"TC-REN-003 | HTTP 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Sin umbral individual: el criterio < 2000 ms se aplica al P95 de las 50 mediciones",
                  "pm.test(\"TC-REN-003 | Response Time válido\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.a(\"number\");",
                  "    pm.expect(pm.response.responseTime).to.be.at.least(0);",
                  "});",
                  "",
                  "// Validaciones auxiliares (no se evalúa la forma funcional del body)",
                  "pm.test(\"TC-REN-003 | Content-Type JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\"))",
                  "        .to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"TC-REN-003 | JSON válido\", function () {",
                  "    pm.expect(function () {",
                  "        pm.response.json();",
                  "    }).to.not.throw();",
                  "});",
                  "",
                  "// Diagnóstico por iteración",
                  "console.log(\"TC-REN-003 | Iteración:\", pm.info.iteration + 1);",
                  "console.log(\"TC-REN-003 | HTTP:\", pm.response.code);",
                  "console.log(\"TC-REN-003 | Response Time:\", pm.response.responseTime, \"ms\");",
                  "console.log(\"TC-REN-003 | Response Size:\", pm.response.responseSize, \"bytes\");"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/breweries/random",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "breweries",
                "random"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
