{
  "info": {
    "_postman_id": "f9c3d7e1-4a8b-4fad-b2c6-tconcon002col",
    "name": "Open BreweryDB - Contrato y Consistencia",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC-CON-002",
      "item": [
        {
          "name": "TC-CON-002 - Paso 1 - Obtener ID válido",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Se limpia cualquier valor previo: el ID debe obtenerse en esta ejecución",
                  "pm.environment.set(\"brewery_id\", \"\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC-CON-002 - Paso 1: obtener un ID válido de forma dinámica",
                  "pm.test(\"TC-CON-002 PRE | HTTP 200 en listado previo\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "let listResponse;",
                  "",
                  "pm.test(\"TC-CON-002 PRE | Listado contiene JSON válido\", function () {",
                  "    pm.expect(function () {",
                  "        listResponse = pm.response.json();",
                  "    }).to.not.throw();",
                  "});",
                  "",
                  "pm.test(\"TC-CON-002 PRE | Listado es un arreglo\", function () {",
                  "    pm.expect(listResponse).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"TC-CON-002 PRE | Listado contiene registros\", function () {",
                  "    pm.expect(listResponse.length).to.be.above(0);",
                  "});",
                  "",
                  "const selectedBrewery = Array.isArray(listResponse) ? listResponse[0] : undefined;",
                  "",
                  "pm.test(\"TC-CON-002 PRE | Registro seleccionado contiene id válido\", function () {",
                  "    pm.expect(selectedBrewery).to.be.an(\"object\");",
                  "    pm.expect(selectedBrewery).to.have.property(\"id\");",
                  "    pm.expect(selectedBrewery.id).to.be.a(\"string\");",
                  "    pm.expect(selectedBrewery.id.length).to.be.above(0);",
                  "});",
                  "",
                  "if (selectedBrewery && typeof selectedBrewery.id === \"string\") {",
                  "    pm.environment.set(\"brewery_id\", selectedBrewery.id);",
                  "    console.log(\"TC-CON-002 | ID obtenido dinámicamente:\", selectedBrewery.id);",
                  "}",
                  "console.log(\"TC-CON-002 | Listado URL:\", pm.request.url.toString());",
                  "console.log(\"TC-CON-002 | Listado HTTP:\", pm.response.code, pm.response.status);",
                  "console.log(\"TC-CON-002 | Response Time listado:\", pm.response.responseTime, \"ms\");"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/breweries",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "breweries"
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC-CON-002 - Paso 2 - Validar tipos de datos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC-CON-002 - Paso 2: contrato de tipos de datos",
                  "// Schema incrustado desde schemas/TC-CON-002-brewery-types.schema.json",
                  "const contractSchema = {",
                  "    \"$schema\": \"http://json-schema.org/draft-07/schema#\",",
                  "    \"title\": \"TC-CON-002 - Tipos de datos Brewery\",",
                  "    \"type\": \"object\",",
                  "    \"required\": [",
                  "        \"id\",",
                  "        \"name\",",
                  "        \"latitude\",",
                  "        \"longitude\"",
                  "    ],",
                  "    \"properties\": {",
                  "        \"id\": {",
                  "            \"type\": \"string\"",
                  "        },",
                  "        \"name\": {",
                  "            \"type\": \"string\"",
                  "        },",
                  "        \"latitude\": {",
                  "            \"type\": [",
                  "                \"number\",",
                  "                \"null\"",
                  "            ]",
                  "        },",
                  "        \"longitude\": {",
                  "            \"type\": [",
                  "                \"number\",",
                  "                \"null\"",
                  "            ]",
                  "        }",
                  "    }",
                  "};",
                  "",
                  "pm.test(\"TC-CON-002 | HTTP 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"TC-CON-002 | La respuesta es JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\"))",
                  "        .to.include(\"application/json\");",
                  "});",
                  "",
                  "let detailResponse;",
                  "",
                  "pm.test(\"TC-CON-002 | El cuerpo contiene JSON válido\", function () {",
                  "    pm.expect(function () {",
                  "        detailResponse = pm.response.json();",
                  "    }).to.not.throw();",
                  "});",
                  "",
                  "pm.test(\"TC-CON-002 | La raíz es un objeto JSON\", function () {",
                  "    pm.expect(detailResponse).to.be.an(\"object\");",
                  "    pm.expect(Array.isArray(detailResponse)).to.be.false;",
                  "});",
                  "",
                  "// Assertions explícitas de tipos (sin truthiness: 0 es un número válido)",
                  "pm.test(\"TC-CON-002 | id es String\", function () {",
                  "    pm.expect(detailResponse).to.have.property(\"id\");",
                  "    pm.expect(detailResponse.id).to.be.a(\"string\");",
                  "});",
                  "",
                  "pm.test(\"TC-CON-002 | name es String\", function () {",
                  "    pm.expect(detailResponse).to.have.property(\"name\");",
                  "    pm.expect(detailResponse.name).to.be.a(\"string\");",
                  "});",
                  "",
                  "pm.test(\"TC-CON-002 | latitude es Number o Null\", function () {",
                  "    pm.expect(detailResponse).to.have.property(\"latitude\");",
                  "",
                  "    const latitudeIsValid =",
                  "        detailResponse.latitude === null ||",
                  "        (",
                  "            typeof detailResponse.latitude === \"number\" &&",
                  "            Number.isFinite(detailResponse.latitude)",
                  "        );",
                  "",
                  "    pm.expect(latitudeIsValid).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"TC-CON-002 | longitude es Number o Null\", function () {",
                  "    pm.expect(detailResponse).to.have.property(\"longitude\");",
                  "",
                  "    const longitudeIsValid =",
                  "        detailResponse.longitude === null ||",
                  "        (",
                  "            typeof detailResponse.longitude === \"number\" &&",
                  "            Number.isFinite(detailResponse.longitude)",
                  "        );",
                  "",
                  "    pm.expect(longitudeIsValid).to.be.true;",
                  "});",
                  "",
                  "// Validación AJV / JSON Schema",
                  "let Ajv;",
                  "let ajvLoadError = null;",
                  "try {",
                  "    Ajv = require(\"ajv\");",
                  "} catch (e) {",
                  "    ajvLoadError = e;",
                  "}",
                  "",
                  "if (Ajv) {",
                  "    const ajv = new Ajv({ allErrors: true });",
                  "",
                  "    const validateContract = ajv.compile(contractSchema);",
                  "    const valid = validateContract(detailResponse);",
                  "",
                  "    console.log(\"TC-CON-002 | AJV ejecutado: Sí\");",
                  "    console.log(\"TC-CON-002 | AJV resultado:\", valid ? \"PASS\" : \"FAIL\");",
                  "    console.log(",
                  "        \"TC-CON-002 | AJV errores:\",",
                  "        JSON.stringify(validateContract.errors || [])",
                  "    );",
                  "",
                  "    pm.test(\"TC-CON-002 | JSON cumple el schema de tipos\", function () {",
                  "        pm.expect(",
                  "            valid,",
                  "            JSON.stringify(validateContract.errors || [])",
                  "        ).to.be.true;",
                  "    });",
                  "} else {",
                  "    console.log(\"TC-CON-002 | AJV no ejecutado por limitación del entorno:\", String(ajvLoadError));",
                  "    console.log(\"TC-CON-002 | Validación equivalente de tipos realizada con Chai.\");",
                  "}",
                  "",
                  "// Diagnóstico de tipos (null se reporta explícitamente como \"null\")",
                  "function realType(value) {",
                  "    if (value === null) { return \"null\"; }",
                  "    if (Array.isArray(value)) { return \"array\"; }",
                  "    return typeof value;",
                  "}",
                  "",
                  "if (detailResponse && typeof detailResponse === \"object\") {",
                  "    console.log(",
                  "        \"TC-CON-002 | id:\",",
                  "        detailResponse.id,",
                  "        \"| typeof:\",",
                  "        realType(detailResponse.id)",
                  "    );",
                  "",
                  "    console.log(",
                  "        \"TC-CON-002 | name:\",",
                  "        detailResponse.name,",
                  "        \"| typeof:\",",
                  "        realType(detailResponse.name)",
                  "    );",
                  "",
                  "    console.log(",
                  "        \"TC-CON-002 | latitude:\",",
                  "        detailResponse.latitude,",
                  "        \"| typeof:\",",
                  "        realType(detailResponse.latitude)",
                  "    );",
                  "",
                  "    console.log(",
                  "        \"TC-CON-002 | longitude:\",",
                  "        detailResponse.longitude,",
                  "        \"| typeof:\",",
                  "        realType(detailResponse.longitude)",
                  "    );",
                  "}",
                  "console.log(\"TC-CON-002 | Detalle URL:\", pm.request.url.toString());",
                  "console.log(\"TC-CON-002 | Detalle HTTP:\", pm.response.code, pm.response.status);",
                  "console.log(",
                  "    \"TC-CON-002 | Response Time:\",",
                  "    pm.response.responseTime,",
                  "    \"ms\"",
                  ");"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/breweries/{{brewery_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "breweries",
                "{{brewery_id}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
