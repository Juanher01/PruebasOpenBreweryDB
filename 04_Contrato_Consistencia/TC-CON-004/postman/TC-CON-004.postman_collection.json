{
  "info": {
    "_postman_id": "b5e2f8a1-6c3d-4f9b-9d08-tconcon004col",
    "name": "Open BreweryDB - Contrato y Consistencia",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC-CON-004",
      "item": [
        {
          "name": "TC-CON-004 - Estructura de metadatos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC-CON-004 - Estructura de metadatos (campos obligatorios; adicionales permitidos)",
                  "// Schema incrustado desde schemas/TC-CON-004-meta.schema.json",
                  "const contractSchema = {",
                  "    \"$schema\": \"http://json-schema.org/draft-07/schema#\",",
                  "    \"title\": \"TC-CON-004 - Metadatos obligatorios\",",
                  "    \"type\": \"object\",",
                  "    \"required\": [",
                  "        \"total\",",
                  "        \"page\",",
                  "        \"per_page\"",
                  "    ],",
                  "    \"properties\": {",
                  "        \"total\": {",
                  "            \"type\": \"integer\"",
                  "        },",
                  "        \"page\": {",
                  "            \"type\": \"integer\"",
                  "        },",
                  "        \"per_page\": {",
                  "            \"type\": \"integer\"",
                  "        }",
                  "    }",
                  "};",
                  "",
                  "pm.test(\"TC-CON-004 | HTTP 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"TC-CON-004 | La respuesta es JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\"))",
                  "        .to.include(\"application/json\");",
                  "});",
                  "",
                  "let metaResponse;",
                  "",
                  "pm.test(\"TC-CON-004 | El cuerpo contiene JSON válido\", function () {",
                  "    pm.expect(function () {",
                  "        metaResponse = pm.response.json();",
                  "    }).to.not.throw();",
                  "});",
                  "",
                  "pm.test(\"TC-CON-004 | La raíz es un objeto JSON\", function () {",
                  "    pm.expect(metaResponse).to.be.an(\"object\");",
                  "    pm.expect(Array.isArray(metaResponse)).to.be.false;",
                  "});",
                  "",
                  "// Presencia",
                  "pm.test(\"TC-CON-004 | Campo total presente\", function () {",
                  "    pm.expect(metaResponse).to.have.property(\"total\");",
                  "});",
                  "",
                  "pm.test(\"TC-CON-004 | Campo page presente\", function () {",
                  "    pm.expect(metaResponse).to.have.property(\"page\");",
                  "});",
                  "",
                  "pm.test(\"TC-CON-004 | Campo per_page presente\", function () {",
                  "    pm.expect(metaResponse).to.have.property(\"per_page\");",
                  "});",
                  "",
                  "// Tipo entero (sin conversión de strings numéricos)",
                  "pm.test(\"TC-CON-004 | total es entero\", function () {",
                  "    pm.expect(Number.isInteger(metaResponse.total)).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"TC-CON-004 | page es entero\", function () {",
                  "    pm.expect(Number.isInteger(metaResponse.page)).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"TC-CON-004 | per_page es entero\", function () {",
                  "    pm.expect(Number.isInteger(metaResponse.per_page)).to.be.true;",
                  "});",
                  "",
                  "// Validación AJV / JSON Schema",
                  "let Ajv;",
                  "let ajvLoadError = null;",
                  "try {",
                  "    Ajv = require(\"ajv\");",
                  "} catch (e) {",
                  "    ajvLoadError = e;",
                  "}",
                  "",
                  "if (Ajv) {",
                  "    const ajv = new Ajv({ allErrors: true });",
                  "",
                  "    const validateContract = ajv.compile(contractSchema);",
                  "    const valid = validateContract(metaResponse);",
                  "",
                  "    console.log(\"TC-CON-004 | AJV ejecutado: Sí\");",
                  "    console.log(",
                  "        \"TC-CON-004 | AJV resultado:\",",
                  "        valid ? \"PASS\" : \"FAIL\"",
                  "    );",
                  "    console.log(",
                  "        \"TC-CON-004 | AJV errores:\",",
                  "        JSON.stringify(validateContract.errors || [])",
                  "    );",
                  "",
                  "    pm.test(\"TC-CON-004 | JSON cumple el schema de metadatos obligatorios\", function () {",
                  "        pm.expect(",
                  "            valid,",
                  "            JSON.stringify(validateContract.errors || [])",
                  "        ).to.be.true;",
                  "    });",
                  "} else {",
                  "    console.log(\"TC-CON-004 | AJV ejecutado: No — limitación del entorno:\", String(ajvLoadError));",
                  "    console.log(\"TC-CON-004 | Validación equivalente realizada con Chai.\");",
                  "}",
                  "",
                  "// Diagnóstico de propiedades adicionales (no produce FAIL)",
                  "if (metaResponse && typeof metaResponse === \"object\") {",
                  "    const requiredKeys = [\"total\", \"page\", \"per_page\"];",
                  "    const actualKeys = Object.keys(metaResponse).sort();",
                  "",
                  "    const additionalKeys = actualKeys.filter(function (key) {",
                  "        return !requiredKeys.includes(key);",
                  "    });",
                  "",
                  "    const missingKeys = requiredKeys.filter(function (key) {",
                  "        return !Object.prototype.hasOwnProperty.call(metaResponse, key);",
                  "    });",
                  "",
                  "    console.log(\"TC-CON-004 | Propiedades reales:\", actualKeys);",
                  "    console.log(\"TC-CON-004 | Campos obligatorios faltantes:\", missingKeys);",
                  "    console.log(\"TC-CON-004 | Campos adicionales:\", additionalKeys);",
                  "",
                  "    // Diagnóstico de tipos",
                  "    console.log(",
                  "        \"TC-CON-004 | total:\",",
                  "        metaResponse.total,",
                  "        \"| typeof:\",",
                  "        typeof metaResponse.total,",
                  "        \"| integer:\",",
                  "        Number.isInteger(metaResponse.total)",
                  "    );",
                  "",
                  "    console.log(",
                  "        \"TC-CON-004 | page:\",",
                  "        metaResponse.page,",
                  "        \"| typeof:\",",
                  "        typeof metaResponse.page,",
                  "        \"| integer:\",",
                  "        Number.isInteger(metaResponse.page)",
                  "    );",
                  "",
                  "    console.log(",
                  "        \"TC-CON-004 | per_page:\",",
                  "        metaResponse.per_page,",
                  "        \"| typeof:\",",
                  "        typeof metaResponse.per_page,",
                  "        \"| integer:\",",
                  "        Number.isInteger(metaResponse.per_page)",
                  "    );",
                  "}",
                  "console.log(\"TC-CON-004 | URL:\", pm.request.url.toString());",
                  "console.log(\"TC-CON-004 | HTTP:\", pm.response.code, pm.response.status);",
                  "console.log(",
                  "    \"TC-CON-004 | Response Time:\",",
                  "    pm.response.responseTime,",
                  "    \"ms\"",
                  ");"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/breweries/meta",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "breweries",
                "meta"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
