{
  "info": {
    "_postman_id": "a3d0e6f9-5b2c-4e8a-8c97-tconcon003col",
    "name": "Open BreweryDB - Contrato y Consistencia",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC-CON-003",
      "item": [
        {
          "name": "TC-CON-003 - Paso 1 - Obtener registro desde listado",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Se limpian valores previos: el ID y el snapshot deben obtenerse en esta ejecución",
                  "pm.environment.set(\"brewery_id\", \"\");",
                  "pm.environment.set(\"list_brewery_snapshot\", \"\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC-CON-003 - Paso 1: obtener registro desde el listado",
                  "pm.test(\"TC-CON-003 PRE | Listado responde HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"TC-CON-003 PRE | Listado es JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\"))",
                  "        .to.include(\"application/json\");",
                  "});",
                  "",
                  "let listResponse;",
                  "",
                  "pm.test(\"TC-CON-003 PRE | Listado contiene JSON válido\", function () {",
                  "    pm.expect(function () {",
                  "        listResponse = pm.response.json();",
                  "    }).to.not.throw();",
                  "});",
                  "",
                  "pm.test(\"TC-CON-003 PRE | Listado es un arreglo\", function () {",
                  "    pm.expect(listResponse).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"TC-CON-003 PRE | Listado contiene registros\", function () {",
                  "    pm.expect(listResponse.length).to.be.above(0);",
                  "});",
                  "",
                  "// Selección dinámica del primer registro disponible",
                  "const selectedBrewery = Array.isArray(listResponse) ? listResponse[0] : undefined;",
                  "",
                  "pm.test(\"TC-CON-003 PRE | Registro seleccionado contiene id válido\", function () {",
                  "    pm.expect(selectedBrewery).to.be.an(\"object\");",
                  "    pm.expect(selectedBrewery).to.have.property(\"id\");",
                  "    pm.expect(selectedBrewery.id).to.be.a(\"string\");",
                  "    pm.expect(selectedBrewery.id.length).to.be.above(0);",
                  "});",
                  "",
                  "// Guardar ID y snapshot completo, sin agregar ni eliminar propiedades",
                  "if (selectedBrewery && typeof selectedBrewery.id === \"string\") {",
                  "    pm.environment.set(\"brewery_id\", selectedBrewery.id);",
                  "",
                  "    pm.environment.set(",
                  "        \"list_brewery_snapshot\",",
                  "        JSON.stringify(selectedBrewery)",
                  "    );",
                  "",
                  "    console.log(",
                  "        \"TC-CON-003 | ID seleccionado:\",",
                  "        selectedBrewery.id",
                  "    );",
                  "",
                  "    console.log(",
                  "        \"TC-CON-003 | Campos en objeto del listado:\",",
                  "        Object.keys(selectedBrewery)",
                  "    );",
                  "}",
                  "console.log(\"TC-CON-003 | Listado URL:\", pm.request.url.toString());",
                  "console.log(\"TC-CON-003 | Listado HTTP:\", pm.response.code, pm.response.status);",
                  "console.log(\"TC-CON-003 | Listado registros:\", Array.isArray(listResponse) ? listResponse.length : \"N/A\");",
                  "console.log(\"TC-CON-003 | Response Time listado:\", pm.response.responseTime, \"ms\");"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/breweries",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "breweries"
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC-CON-003 - Paso 2 - Consultar y comparar detalle",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC-CON-003 - Paso 2: detalle por el mismo ID y comparación profunda con el listado",
                  "pm.test(\"TC-CON-003 | Detalle responde HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"TC-CON-003 | Detalle es JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\"))",
                  "        .to.include(\"application/json\");",
                  "});",
                  "",
                  "let detailResponse;",
                  "",
                  "pm.test(\"TC-CON-003 | Detalle contiene JSON válido\", function () {",
                  "    pm.expect(function () {",
                  "        detailResponse = pm.response.json();",
                  "    }).to.not.throw();",
                  "});",
                  "",
                  "pm.test(\"TC-CON-003 | Detalle es un objeto JSON\", function () {",
                  "    pm.expect(detailResponse).to.be.an(\"object\");",
                  "    pm.expect(Array.isArray(detailResponse)).to.be.false;",
                  "});",
                  "",
                  "// Recuperar snapshot del listado (sin normalizar)",
                  "let listSnapshot;",
                  "try {",
                  "    listSnapshot = JSON.parse(",
                  "        pm.environment.get(\"list_brewery_snapshot\")",
                  "    );",
                  "} catch (e) {",
                  "    listSnapshot = undefined;",
                  "}",
                  "",
                  "pm.test(\"TC-CON-003 | Snapshot del listado disponible\", function () {",
                  "    pm.expect(listSnapshot).to.be.an(\"object\");",
                  "    pm.expect(listSnapshot).to.have.property(\"id\");",
                  "});",
                  "",
                  "pm.test(\"TC-CON-003 | ID del detalle coincide con el solicitado\", function () {",
                  "    const requestedId = pm.environment.get(\"brewery_id\");",
                  "",
                  "    pm.expect(detailResponse).to.have.property(\"id\");",
                  "    pm.expect(detailResponse.id).to.eql(requestedId);",
                  "    pm.expect(detailResponse.id).to.eql(listSnapshot.id);",
                  "});",
                  "",
                  "// Assertion principal: igualdad profunda (el orden de propiedades no influye)",
                  "pm.test(\"TC-CON-003 | Detalle coincide con objeto del mismo ID en listado\", function () {",
                  "    pm.expect(detailResponse).to.deep.equal(listSnapshot);",
                  "});",
                  "",
                  "// Validación complementaria de propiedades",
                  "pm.test(\"TC-CON-003 | Listado y detalle tienen las mismas propiedades\", function () {",
                  "    const listKeys = Object.keys(listSnapshot).sort();",
                  "    const detailKeys = Object.keys(detailResponse).sort();",
                  "",
                  "    pm.expect(detailKeys).to.deep.equal(listKeys);",
                  "});",
                  "",
                  "// Diagnóstico de diferencias (solo diagnóstico; no altera la assertion principal)",
                  "function stableValue(value) {",
                  "    if (",
                  "        value !== null &&",
                  "        typeof value === \"object\" &&",
                  "        !Array.isArray(value)",
                  "    ) {",
                  "        const sorted = {};",
                  "        Object.keys(value)",
                  "            .sort()",
                  "            .forEach(function (key) {",
                  "                sorted[key] = stableValue(value[key]);",
                  "            });",
                  "        return sorted;",
                  "    }",
                  "",
                  "    if (Array.isArray(value)) {",
                  "        return value.map(stableValue);",
                  "    }",
                  "",
                  "    return value;",
                  "}",
                  "",
                  "if (",
                  "    listSnapshot && typeof listSnapshot === \"object\" &&",
                  "    detailResponse && typeof detailResponse === \"object\"",
                  ") {",
                  "    const allKeys = Array.from(",
                  "        new Set([",
                  "            ...Object.keys(listSnapshot),",
                  "            ...Object.keys(detailResponse)",
                  "        ])",
                  "    ).sort();",
                  "",
                  "    const differences = [];",
                  "",
                  "    allKeys.forEach(function (key) {",
                  "        const listValue = listSnapshot[key];",
                  "        const detailValue = detailResponse[key];",
                  "",
                  "        const same =",
                  "            JSON.stringify(stableValue(listValue)) ===",
                  "            JSON.stringify(stableValue(detailValue));",
                  "",
                  "        if (!same) {",
                  "            differences.push({",
                  "                field: key,",
                  "                listValue: listValue,",
                  "                detailValue: detailValue,",
                  "                listType:",
                  "                    listValue === null ? \"null\" : typeof listValue,",
                  "                detailType:",
                  "                    detailValue === null ? \"null\" : typeof detailValue",
                  "            });",
                  "        }",
                  "    });",
                  "",
                  "    console.log(",
                  "        \"TC-CON-003 | Cantidad campos listado:\",",
                  "        Object.keys(listSnapshot).length",
                  "    );",
                  "",
                  "    console.log(",
                  "        \"TC-CON-003 | Cantidad campos detalle:\",",
                  "        Object.keys(detailResponse).length",
                  "    );",
                  "",
                  "    console.log(",
                  "        \"TC-CON-003 | Diferencias:\",",
                  "        JSON.stringify(differences)",
                  "    );",
                  "",
                  "    console.log(",
                  "        \"TC-CON-003 | Cantidad de diferencias:\",",
                  "        differences.length",
                  "    );",
                  "}",
                  "console.log(\"TC-CON-003 | Detalle URL:\", pm.request.url.toString());",
                  "console.log(\"TC-CON-003 | Detalle HTTP:\", pm.response.code, pm.response.status);",
                  "console.log(\"TC-CON-003 | ID retornado:\", detailResponse ? detailResponse.id : \"N/A\");",
                  "console.log(\"TC-CON-003 | Response Time detalle:\", pm.response.responseTime, \"ms\");"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/breweries/{{brewery_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "breweries",
                "{{brewery_id}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
