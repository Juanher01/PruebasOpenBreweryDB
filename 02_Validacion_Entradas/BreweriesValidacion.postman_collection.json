            "exec": [
              "pm.test(\"El código HTTP es 200 o 400\", function () {\r",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);\r",
              "});\r",
              "\r",
              "pm.test(\"Manejo correcto de tipo inexistente\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    if (pm.response.code === 200) {\r",
              "        // Si responde 200, DEBE ser un arreglo vacío\r",
              "        pm.expect(jsonData).to.be.an('array').that.is.empty;\r",
              "    } else if (pm.response.code === 400) {\r",
              "        // Si responde 400, debe devolver un objeto JSON con el detalle del error\r",
              "        pm.expect(jsonData).to.be.an('object');\r",
              "    }\r",
              "});"
            ],
