    {
      "name": "TC-VAL-001: by_state texas",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Validar que el código HTTP sea 200 OK\r",
              "pm.test(\"El código de respuesta es 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Validar que la respuesta sea un arreglo JSON\r",
              "pm.test(\"La respuesta es un arreglo JSON\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.be.an('array');\r",
              "});\r",
              "\r",
              "// 3. Validar que los datos devueltos sean de Texas\r",
              "pm.test(\"Las cervecerías devueltas pertenecen a Texas\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    // Si el arreglo tiene datos, revisamos el primer elemento\r",
              "    if (jsonData.length > 0) {\r",
              "        // Asumiendo que el campo se llama 'state'\r",
              "        pm.expect(jsonData[0].state.toLowerCase()).to.include(\"texas\");\r",
              "    }\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "packages": {},
            "type": "text/javascript"
          }
        }
      ],
